# === Meta WhatsApp Cloud API ===
# Meta for Developers > tu App > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Meta for Developers > tu App > WhatsApp > Configuration > Webhook
# Tú inventas este valor; debe coincidir exactamente con el que pongas en el dashboard de Meta.
WHATSAPP_VERIFY_TOKEN=elige-un-valor-secreto-aqui

# Meta for Developers > tu App > Configuración básica > "Clave secreta de la app" (App Secret)
# Se usa para validar la firma X-Hub-Signature-256 de cada webhook entrante.
WHATSAPP_APP_SECRET=tu_app_secret_aqui

# Número del hotel tal cual está en hotel-data.json (sin +, sin espacios), para logs/alertas.
HOTEL_WHATSAPP_NUMBER=524183357375

# Número(s) de WhatsApp (formato E.164 sin '+', ej. 524XXXXXXXXX) donde el
# bot avisa al staff/recepción cuando alguien quiere reservar, pide un
# agente, o pregunta por fechas sin disponibilidad. Uno solo, o varios
# separados por coma: 524XXXXXXXXX,524YYYYYYYYY
# Opcional — si se deja vacío el bot funciona igual para el huésped, solo no
# manda esas alertas internas.
# RECOMENDADO: usa un número "de mostrador" compartido entre turnos, no el
# celular personal de cada recepcionista — así no importa quién esté de
# turno ese día.
# IMPORTANTE: para que las alertas de texto libre siempre lleguen, cada
# número de esta lista debe escribirle "hola" al número del bot al menos
# una vez cada 24h (así se mantiene abierta la ventana de conversación de
# WhatsApp) — ver nota en whatsappClient.js.
HOTEL_STAFF_WHATSAPP_NUMBER=

# === Correo a recepción ===
# A dónde van (a) los documentos/fotos que manden los huéspedes por
# WhatsApp (Constancia de Situación Fiscal, recibos, etc.) y (b) el
# registro de cada nueva reservación confirmada por el bot.
#
# Configurado por default para el correo de Yahoo del hotel. Si usan otro
# proveedor, cambien SMTP_HOST/SMTP_PORT/SMTP_SECURE según corresponda.
#
# SMTP_PASS debe ser una "contraseña de aplicación" generada en la
# configuración de seguridad de la cuenta de correo — NO la contraseña
# normal de la cuenta (Yahoo/Gmail no la aceptan para SMTP de terceros).
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hotelposadacocomacan@yahoo.com.mx
SMTP_PASS=

# Opcional — si se deja vacío, los correos llegan al mismo SMTP_USER (un
# solo buzón compartido para el hotel).
RECEPTION_EMAIL=

# === Anthropic (para el motor de preguntas frecuentes) ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Revisa el modelo vigente en https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-4-6

# === Servidor ===
PORT=3000
